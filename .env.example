# ==============================================================================
# Telegram Anonymous Student Bot - Production Environment Configuration
# ==============================================================================

# توكن البوت من BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# معرف القناة الخاصة (مع إشارة السالب للقنوات والمجموعات الخارقة)
CHANNEL_ID=-1001234567890

# رابط الانضمام الخاص بالقناة (يُعرض للطلاب الذين لم ينضموا بعد)
CHANNEL_INVITE_LINK=https://t.me/+AbCdEfGhIjKlMnOp

# معرف المسؤول الأساسي (Primary Admin) - المالك الحصري لصلاحية كشف الهوية، تعيين كلمات المرور، والتطهير
PRIMARY_ADMIN_ID=123456789

# معرفات المشرفين (Moderators) مفصولة بفواصل (حظر، كتم، وحذف دون كشف الهوية)
MODERATOR_IDS=987654321,555555555

# تجزئة كلمة مرور الإدارة العامة المشتركة (تُستخدم كبديل احتياطي إذا لم يتم تعيين كلمة مرور فردية للمشرف عبر /set_admin_password)
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c$d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5

# مدة بقاء جلسة المشرف نشطة بالدقائق
ADMIN_SESSION_EXPIRY_MINUTES=120

# قناة سجلات المشرفين السرية (اختياري، اتركها فارغة إذا لا ترغب في استخدامها)
ADMIN_LOG_CHANNEL_ID=

# مفتاح التشفير لقاعدة البيانات (يتم توليده عبر utils/key_generator.py)
ENCRYPTION_KEY=s8zPzX1w2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p7q8r9=

# رابط الاتصال بقاعدة بيانات PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anonymous_bot
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_COMMAND_TIMEOUT=10.0
DATABASE_CONNECT_TIMEOUT=10.0
# DATABASE_SSL_MODE=require

# إعدادات Webhook للإنتاج (اختياري، اتركه فارغاً لاستخدام Polling)
WEBHOOK_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000

# إعدادات مكافحة الإغراق والسبام ومعدل الإرسال
RATE_LIMIT_SECONDS=5
MAX_SUBMISSIONS_PER_HOUR=20

# حدود الوسائط والملفات
MAX_FILE_SIZE_MB=20
MEDIA_TEMP_DIR=media_tmp

# إعدادات الفلاتر ومحرك الرقابة النشطة
ENABLE_PROFANITY_FILTER=true
ALLOW_LINKS_IN_SUBMISSIONS=false
MODERATION_MODE=strict
ENABLE_OCR=true
ENABLE_ASR=false
FAIL_CLOSED_ON_MEDIA_ANALYSIS_ERROR=true

# سياسات حظر الفئات المحددة
BLOCK_PROFANITY=true
BLOCK_SEXUAL=true
BLOCK_HARASSMENT=true
BLOCK_BULLYING=true
BLOCK_THREATS=true
BLOCK_HATE=true
